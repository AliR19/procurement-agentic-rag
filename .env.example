# --- LLM ---------------------------------------------------------------
# demo   = rule-based stand-in, no model needed (default)
# ollama = local model. Use a TOOL-CALLING model: llama3.1 or llama3.2 (plain "llama3" cannot call tools)
# openai = OpenAI API (set OPENAI_API_KEY)
LLM_PROVIDER=demo
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Embeddings --------------------------------------------------------
# auto = sentence-transformers if installed, else lexical hashing fallback
# sentence-transformers | hashing
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Services ----------------------------------------------------------
ERP_BASE_URL=http://localhost:8001
ERP_API_KEY=dev-key
